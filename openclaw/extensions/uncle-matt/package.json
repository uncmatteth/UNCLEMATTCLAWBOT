{
  "name": "@uncmatteth/uncle-matt-openclaw-extension",
  "version": "4.20.69",
  "description": "Uncle Matt routes approved action IDs through a hardened local Broker so OpenClaw agents can use APIs without seeing secrets or calling arbitrary URLs.",
  "license": "MIT-0",
  "homepage": "https://bobsturtletank.fun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uncmatteth/UNCLEMATTCLAWBOT.git",
    "directory": "openclaw/extensions/uncle-matt"
  },
  "keywords": [
    "openclaw",
    "uncle-matt",
    "security",
    "broker",
    "mtls",
    "guardrails",
    "no-secrets",
    "prompt-injection",
    "api-proxy"
  ],
  "private": true,
  "type": "module",
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.18",
      "minGatewayVersion": "2026.5.18"
    },
    "build": {
      "openclawVersion": "2026.5.18",
      "pluginSdkVersion": "2026.5.18"
    }
  }
}
