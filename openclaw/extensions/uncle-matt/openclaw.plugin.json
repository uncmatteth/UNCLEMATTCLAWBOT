{
  "id": "uncle-matt",
  "name": "Uncle Matt",
  "description": "Uncle Matt routes approved action IDs through a hardened local Broker so secrets stay out of the agent.",
  "skills": [
    "./skills"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": { "type": "string" },
      "caPath": { "type": "string" },
      "clientCertPath": { "type": "string" },
      "clientKeyPath": { "type": "string" },
      "timeoutMs": { "type": "number" },
      "maxRequestBytes": { "type": "number" },
      "maxResponseBytes": { "type": "number" },
      "voicePackEnabled": { "type": "boolean" }
    },
    "required": ["baseUrl", "caPath", "clientCertPath", "clientKeyPath"]
  },
  "uiHints": {
    "baseUrl": {
      "label": "Uncle Matt Broker URL",
      "placeholder": "https://127.0.0.1:8443"
    },
    "caPath": {
      "label": "CA cert path",
      "placeholder": "~/.secure-openclaw/certs/ca.crt"
    },
    "clientCertPath": {
      "label": "Client cert path",
      "placeholder": "~/.secure-openclaw/certs/client.crt"
    },
    "clientKeyPath": {
      "label": "Client key path",
      "placeholder": "~/.secure-openclaw/certs/client.key",
      "sensitive": true
    },
    "timeoutMs": {
      "label": "Timeout (ms)",
      "placeholder": "15000"
    },
    "maxRequestBytes": {
      "label": "Max request bytes",
      "placeholder": "1000000"
    },
    "maxResponseBytes": {
      "label": "Max response bytes",
      "placeholder": "50000"
    },
    "voicePackEnabled": {
      "label": "Enable Uncle Matt voice pack",
      "placeholder": "false"
    }
  },
  "version": "5.420.69",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "uncle_matt_action"
    ]
  },
  "toolMetadata": {
    "uncle_matt_action": {
      "optional": true
    }
  }
}
