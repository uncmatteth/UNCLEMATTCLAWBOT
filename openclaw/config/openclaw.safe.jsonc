// OpenClaw safe-default template (NO secrets)
// IMPORTANT: installer should verify actual config keys + tool names via OpenClaw CLI outputs
{
  // Conceptual settings:
  // - sandbox mode all
  // - workspaceAccess none
  // - docker network none
  // - deny-by-default tools; allow only minimal safe tools + uncle_matt_action when opted-in

  "agents": {
    "defaults": {
      "sandbox": {
        "mode": "all",
        "workspaceAccess": "none",
        "docker": {
          "network": "none",
          "readOnlyRoot": true
        }
      }
    }
  },
  "tools": {
    // Deny-by-default stance: explicitly restrict core tools and allow only the broker tool.
    "profile": "minimal",
    "allow": ["uncle_matt_action"],
    "deny": [
      "group:runtime",
      "group:browser",
      "group:ui",
      "group:fs"
    ]
  }
}
