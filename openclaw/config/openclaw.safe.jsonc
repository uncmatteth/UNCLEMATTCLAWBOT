// OpenClaw safe-default template (NO secrets)
// IMPORTANT: installer should verify actual config keys + tool names via OpenClaw CLI outputs
{
  // Conceptual settings:
  // - sandbox mode all
  // - workspaceAccess none
  // - docker network none
  // - deny-by-default tools; allow only uncle_matt_action when opted-in

  "agents": {
    "defaults": {
      "sandbox": {
        "mode": "all",
        "workspaceAccess": "none",
        "docker": {
          "network": "none",
          "readOnlyRoot": true
        }
      }
    }
  },
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": {
        "source": "env",
        "provider": "default",
        "id": "OPENCLAW_GATEWAY_TOKEN"
      }
    }
  },
  "tools": {
    // Plugin tools are filtered out by OpenClaw's minimal profile before the
    // explicit allowlist is applied. Start from full, then narrow to exactly
    // the broker tool and retain the explicit dangerous-tool denies.
    "profile": "full",
    "allow": ["uncle_matt_action"],
    "deny": [
      "group:runtime",
      "group:browser",
      "group:ui",
      "group:fs"
    ],
    "sandbox": {
      "tools": {
        // Sandbox tool policy is a second intersection. Without this entry,
        // the registered plugin tool is removed and every agent turn aborts.
        "alsoAllow": ["uncle_matt_action"]
      }
    }
  }
}
