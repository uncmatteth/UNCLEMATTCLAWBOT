{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "actions": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "upstream": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "host": {
                                "type": "string"
                            },
                            "path": {
                                "type": "string",
                                "pattern": "^/[^\\s]*$"
                            }
                        },
                        "required": [
                            "host",
                            "path"
                        ]
                    },
                    "method": {
                        "type": "string",
                        "enum": [
                            "GET",
                            "POST",
                            "PUT",
                            "PATCH",
                            "DELETE"
                        ]
                    },
                    "pathAllowlist": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "type": "string",
                            "pattern": "^/[^\\s]*$"
                        }
                    },
                    "request": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "maxBodyBytes": {
                                "type": "integer",
                                "minimum": 1
                            },
                            "allowedContentTypes": {
                                "type": "array",
                                "minItems": 1,
                                "items": {
                                    "type": "string"
                                }
                            }
                        },
                        "required": [
                            "maxBodyBytes",
                            "allowedContentTypes"
                        ]
                    },
                    "auth": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "kind": {
                                "type": "string",
                                "enum": [
                                    "bearer",
                                    "header",
                                    "none"
                                ]
                            },
                            "secretRef": {
                                "type": "string"
                            },
                            "headerName": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "limits": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "maxResponseBytes": {
                                "type": "integer",
                                "minimum": 1
                            }
                        },
                        "required": [
                            "maxResponseBytes"
                        ]
                    },
                    "rateLimit": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "maxRequests": {
                                "type": "integer",
                                "minimum": 1
                            },
                            "windowSeconds": {
                                "type": "integer",
                                "minimum": 1
                            }
                        },
                        "required": [
                            "maxRequests",
                            "windowSeconds"
                        ]
                    },
                    "budget": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "maxRequests": {
                                "type": "integer",
                                "minimum": 1
                            },
                            "windowSeconds": {
                                "type": "integer",
                                "minimum": 1
                            }
                        },
                        "required": [
                            "maxRequests",
                            "windowSeconds"
                        ]
                    }
                },
                "allOf": [
                    {
                        "if": {
                            "properties": {
                                "auth": {
                                    "properties": {
                                        "kind": { "const": "bearer" }
                                    }
                                }
                            }
                        },
                        "then": {
                            "properties": {
                                "auth": { "required": ["secretRef"] }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "auth": {
                                    "properties": {
                                        "kind": { "const": "header" }
                                    }
                                }
                            }
                        },
                        "then": {
                            "properties": {
                                "auth": { "required": ["secretRef", "headerName"] }
                            }
                        }
                    }
                ],
                "required": [
                    "upstream",
                    "method",
                    "pathAllowlist",
                    "request",
                    "auth",
                    "limits",
                    "rateLimit",
                    "budget"
                ]
            }
        }
    },
    "required": [
        "actions"
    ]
}
